# ==============================================================================
# PhotoTrace AI — Environment Variables Example
# Safe template for local development and Render production deployment.
# Copy to .env for local overrides (never commit real .env to GitHub).
# ==============================================================================

# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production

# Security Key (Generate a random 32-byte hex in production, e.g. using `python -c "import secrets; print(secrets.token_hex(32))"`)
# On Render: Use Render's Secret generator in the Environment tab
SECRET_KEY=change_this_to_a_random_secret_in_production

# Upload bounds (Default: 32MB in bytes)
MAX_CONTENT_LENGTH=33554432

# Reverse Geocoding via OpenStreetMap Nominatim (true / false)
ALLOW_REVERSE_GEOCODING=true

# Host & Port Configuration
# Local default: 127.0.0.1:5000
# Cloud/Render default: Render automatically injects PORT (e.g. 10000) and binds 0.0.0.0
HOST=0.0.0.0
PORT=10000
